{
  "name": "gologin-scraping-api",
  "version": "0.3.0",
  "description": "TypeScript SDK and CLI for the GoLogin Scraping API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gologin-scraping-api": "dist/cli.js",
    "gologin-webunlocker": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "test": "tsx --test tests/**/*.test.ts",
    "release:check": "npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run release:check",
    "example": "tsx examples/basic.ts",
    "cli": "node dist/cli.js"
  },
  "keywords": [
    "gologin",
    "scraping-api",
    "scraping",
    "sdk",
    "webunlocker"
  ],
  "author": "Gologin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GologinLabs/gologin-scraping-api.git"
  },
  "homepage": "https://gologin.com",
  "bugs": {
    "url": "https://github.com/GologinLabs/gologin-scraping-api/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
